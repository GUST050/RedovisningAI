# Kopiera till .env och byt alla värden. Checka aldrig in .env.
POSTGRES_PASSWORD=byt-mig-postgres
RAI_APP_DB_PASSWORD=byt-mig-app
# Minst 32 tecken. Krypterar byråernas datanycklar. I produktion: från Key Vault/KMS.
RAI_MASTER_KEY=byt-mig-till-en-lang-slumpad-nyckel-minst-32-tecken

# dev = utvecklingsinloggning (bara lokalt). prod kräver RAI_AUTH_MODE=oidc.
RAI_ENV=dev
RAI_AUTH_MODE=dev
RAI_WEB_BASE_URL=http://localhost:3000
# RAI_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# RAI_OIDC_AUDIENCE=<app-id>
# RAI_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys

# AI (valfritt). Utan AI används regelbaserade texter.
RAI_AI_ENABLED=false
RAI_AI_PLATFORM=bedrock        # bedrock | vertex | anthropic
RAI_AI_REGION=eu-north-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# RAI_AI_PROJECT_ID=           # Vertex
# ANTHROPIC_API_KEY=           # direkt mot Anthropic

# Fortnox (kräver registrerad integration hos Fortnox)
# RAI_FORTNOX_CLIENT_ID=
# RAI_FORTNOX_CLIENT_SECRET=
# RAI_FORTNOX_REDIRECT_URI=http://localhost:8000/api/connections/fortnox/callback

# Objektlagring: local (volym) eller s3 (t.ex. --profile s3 med MinIO)
RAI_STORAGE_BACKEND=local
# RAI_S3_ENDPOINT=http://minio:9000
# RAI_S3_ACCESS_KEY=minio
# RAI_S3_SECRET_KEY=minio-secret

# PgBouncer (--profile pgbouncer): peka applikationen mot poolern
# RAI_DB_HOST=pgbouncer
# RAI_DB_PORT=5432
